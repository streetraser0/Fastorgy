  "otherVerifiedBehaviors": [
    "Explicit same-unit and implicit upper-unit ranges are preserved; mixed GB/TB asks for clarification.",
    "Saved search uses the same exact query/match set and restores its results.",
    "Manual category remains strict; nearby then distant then unknown position ordering is retained.",
    "New visits clear prior query and automatic category while keeping favorites.",
    "Negation-like prose does not prove excluded color or zero mileage.",
    "Zero mileage excludes unknown mileage; no-mileage-in-a-country requires total mileage clarification.",
    "Euro emission standards, valid non-negation comparators and unrelated words such as synchronizers/pigeons are not rejected.",
    "Unlabelled kilometres do not become a rouble budget; legacy voice radius handling/warnings are preserved.",
    "Grouped1 024GB and grouped monetary amounts remain numeric quantities; iPhone13 is retained as a model."
  ],
  "fixes": [
    {
      "id": "comparative-budgets",
      "before": "Cheaper/more-expensive followed by a numeric or word amount could remain a literal word or be mistaken for sorting only.",
      "after": "RU/EN comparators with an amount become inclusive price bounds using the existing до/от budget convention; bare comparator words remain sort orders. Foreign currency is rejected before conversion."
    },
    {
      "id": "unsupported-alternatives-and-age",
      "before": "Free-text OR or relative age could look like an empty catalogue.",
      "after": "Those expressions request explicit categories/ranges or a calendar year, preserving prior results without adding OR or age inference."
    },
    {
      "id": "quantity-budget-boundary",
      "before": "Exact quantity+unit followed by a bare monetary maximum could absorb the budget as the quantity upper bound.",
      "after": "Repeated units and explicit ranges remain ranges; separate monetary maximum remains a price criterion."
    },
    {
      "id": "foreign-currency",
      "before": "Foreign currency amounts could acquire a rouble label or be consumed before voice canonical validation.",
      "after": "Explicit RU/EN foreign currency amounts return an actionable error with no automatic conversion; voice checks complete canonical input before fallback interpretation."
    },
